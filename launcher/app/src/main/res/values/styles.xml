<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Inter Text everywhere a view names no font: menus, dialogs, settings. See typography.xml. -->
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:colorAccent">@color/ds_accent</item>
        <item name="android:colorControlHighlight">#33FFFFFF</item>
        <item name="android:alertDialogTheme">@style/Theme.TvHome.Dialog</item>
    </style>

    <!-- Only dialogs owned by this app. Android/TCL settings and permission screens keep their theme. -->
    <style name="Theme.TvHome.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glass_panel</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:colorAccent">@color/ds_accent</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/TvDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/TvDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/TvDialogButton</item>
    </style>
    <style name="TvDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/input_row_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:minHeight">@dimen/ds_control_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon-only pill: a 42dp circle (pill_bg's 21dp corners) with the 22dp icon centred by even padding. Give it a
         contentDescription, since there is no text. -->
    <style name="TopButtonIcon" parent="TopButtonBase">
        <item name="android:layout_width">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ds_control_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">@dimen/ds_type_body</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsColumnChoice" parent="SettingsRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
