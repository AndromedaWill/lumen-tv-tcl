<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS pill: Liquid Glass at rest, solid bright white when focused (dark text, pill_text). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F7FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Customize button while rearranging (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#9959759B" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <drawable class="com.gathin.tvhome.LiquidGlassDrawable" />
    </item>
</selector>
